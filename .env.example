# Learnify backend environment (example — copy to .env and fill in).
# This file is committed; do NOT put real secrets here.

# ── Supabase (PostgreSQL + Auth) ───────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWKS_URL=

# Only needed by the DB maintenance scripts (apply_lms_schema,
# backup_live_db, seed_subjects, dedupe_subjects) — the app itself
# authenticates with the two keys above.
SUPABASE_PAT=
SUPABASE_PROJECT=

# ── Groq (AI questionnaires, assessments and report narrative) ─────────────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── Misc ───────────────────────────────────────────────────────────────────
DATA_DIR=data

# Self-service administrator sign-up. There is no hard-coded bootstrap
# account — the first SUPREME registers normally. Set to false once your
# admins exist so only they can create more.
SUPREME_SIGNUP_OPEN=true
